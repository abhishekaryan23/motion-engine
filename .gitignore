target/
target-*/
output/
.DS_Store
scripts/__pycache__/
/test_*.png

# Curated SFX pack copy (rebuilt by sfx-index from a licensed SFX pack)
assets/sfx/library
*.speech-cache/

# Secrets: provider keys live in env or ~/.config/motionengine (never in the repo)
.env
.env.*
providers.toml

# Generated-asset lockfiles (program assets); cache paths are per machine
*.assets.lock.json

# Archify receipts (contain local paths); the specs and HTML are tracked
docs/architecture/*.finalize.json
docs/architecture/*.finalize-summary.json
docs/architecture/*.browser-check.json
docs/architecture/*.delivery.json

# User images for the MCP server (bring your own images; never committed)
assets/inbox/*
!assets/inbox/README.md

# Optional fonts fetched by scripts/fetch_fonts.sh (not redistributable)
assets/fonts/Satoshi-*.otf
assets/fonts/CabinetGrotesk-*.otf
assets/fonts/ClashDisplay-*.otf
assets/fonts/Panchang-*.otf
assets/fonts/Zodiak-*.otf
assets/fonts/Frantically-*.ttf
