  "cards": [
    {
      "dot": "cyan",
      "title": "Weak-model contract",
      "items": [
        "CreativeIntent + five taste fields only",
        "Optional narration per beat; never pixels or timing"
      ]
    },
    {
      "dot": "emerald",
      "title": "Determinism",
      "items": [
        "Same inputs and seeds give byte-identical scenes",
        "Providers stay outside the core; reruns hit caches"
      ]
    },
    {
      "dot": "violet",
      "title": "Voice",
      "items": [
        "Gemini or MAI by locale, free fallbacks",
        "Single take; word timing from recognition"
      ]
    },
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "Key from env or a 0600 config file",
        "Keys and provider URLs never logged"
      ]
    }
  ]
