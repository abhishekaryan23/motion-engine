{
  "$defs": {
    "BackgroundCharacter": {
      "oneOf": [
        {
          "const": "flat",
          "description": "Plain flat ground.",
          "type": "string"
        },
        {
          "const": "paper",
          "description": "Paper-like ground with fibre/grain.",
          "type": "string"
        },
        {
          "const": "gradient",
          "description": "Smooth gradients or vignettes.",
          "type": "string"
        },
        {
          "const": "grid",
          "description": "Measurement grids, guides, technical lines.",
          "type": "string"
        },
        {
          "const": "graphic_fields",
          "description": "Large flat graphic color fields that recompose.",
          "type": "string"
        },
        {
          "const": "photographic",
          "description": "Photographs or footage fill the background.",
          "type": "string"
        },
        {
          "const": "textured",
          "description": "Visible texture (noise, halftone, pattern) over a ground.",
          "type": "string"
        }
      ]
    },
    "EvidenceLinks": {
      "additionalProperties": false,
      "description": "Provenance: which samples, time ranges and deterministic metrics supported an inference.\nIdentifiers only; no reasoning text.",
      "properties": {
        "metrics": {
          "description": "Metric keys from the evidence (e.g. \"temporal.changes_per_10s\").",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "samples": {
          "description": "Sample ids from the request (e.g. \"s03\").",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "time_ranges": {
          "description": "[start, end] in seconds.",
          "items": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ImageTreatmentCharacter": {
      "oneOf": [
        {
          "const": "none",
          "description": "The reference shows no photographs or illustrations.",
          "type": "string"
        },
        {
          "const": "natural",
          "description": "Images shown as they are.",
          "type": "string"
        },
        {
          "const": "monochrome",
          "description": "Black and white / single ink.",
          "type": "string"
        },
        {
          "const": "duotone",
          "description": "Two-ink duotone.",
          "type": "string"
        },
        {
          "const": "muted",
          "description": "Desaturated, low-contrast documentary look.",
          "type": "string"
        },
        {
          "const": "cutout",
          "description": "Cut-out subjects with paper edges and shadows.",
          "type": "string"
        },
        {
          "const": "print_cutout",
          "description": "Bold cut-outs on flat color fields.",
          "type": "string"
        },
        {
          "const": "high_contrast",
          "description": "Crushed blacks, strong contrast.",
          "type": "string"
        }
      ]
    },
    "MaterialCharacter": {
      "oneOf": [
        {
          "const": "paper",
          "description": "Uncoated paper, print grain.",
          "type": "string"
        },
        {
          "const": "flat",
          "description": "Clean flat vector surfaces.",
          "type": "string"
        },
        {
          "const": "screen",
          "description": "Emissive screen / UI surfaces.",
          "type": "string"
        },
        {
          "const": "print",
          "description": "Coated print: flat saturated ink, fine grain.",
          "type": "string"
        },
        {
          "const": "glossy",
          "description": "Glossy highlights and reflections.",
          "type": "string"
        },
        {
          "const": "metallic",
          "description": "Chrome or metal.",
          "type": "string"
        },
        {
          "const": "rendered3d",
          "description": "Rendered 3D surfaces and lighting.",
          "type": "string"
        }
      ]
    },
    "PaletteCharacter": {
      "oneOf": [
        {
          "const": "monochrome",
          "description": "Essentially one hue or greyscale.",
          "type": "string"
        },
        {
          "const": "muted",
          "description": "Desaturated colors throughout.",
          "type": "string"
        },
        {
          "const": "restrained_accent",
          "description": "Neutral grounds with one sparing accent.",
          "type": "string"
        },
        {
          "const": "vivid",
          "description": "Neutral grounds with strong saturated accents.",
          "type": "string"
        },
        {
          "const": "multicolor",
          "description": "Several saturated colors used as large fields.",
          "type": "string"
        }
      ]
    },
    "PaletteEvidenceSwatch": {
      "additionalProperties": false,
      "description": "An approximate color from the evidence.",
      "properties": {
        "hex": {
          "description": "\"#RRGGBB\".",
          "type": "string"
        },
        "prevalence": {
          "description": "Share of the frame area, 0..1.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "hex",
        "prevalence"
      ],
      "type": "object"
    },
    "RefActivity": {
      "description": "Activity of a supporting layer.",
      "oneOf": [
        {
          "enum": [
            "still",
            "quiet",
            "active"
          ],
          "type": "string"
        },
        {
          "const": "structured",
          "description": "Regular, systematic motion (grids, ticks).",
          "type": "string"
        }
      ]
    },
    "RefDensity": {
      "enum": [
        "sparse",
        "balanced",
        "dense"
      ],
      "type": "string"
    },
    "RefLayerActivity": {
      "additionalProperties": false,
      "description": "Per-layer activity; omit or null any part that is unclear.",
      "properties": {
        "background": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefActivity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "foreground": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefPresence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "midground": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefActivity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object"
    },
    "RefLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "RefPolarity": {
      "oneOf": [
        {
          "const": "light",
          "description": "Light grounds, dark content.",
          "type": "string"
        },
        {
          "const": "dark",
          "description": "Dark grounds, light content.",
          "type": "string"
        },
        {
          "const": "mixed",
          "description": "Both light and dark compositions are substantial.",
          "type": "string"
        }
      ]
    },
    "RefPresence": {
      "description": "Presence of the foreground (main content).",
      "enum": [
        "recessive",
        "balanced",
        "dominant"
      ],
      "type": "string"
    },
    "RefRhythm": {
      "oneOf": [
        {
          "const": "slow_breathing",
          "description": "Long holds, few slow changes.",
          "type": "string"
        },
        {
          "const": "measured_editorial",
          "description": "Steady editorial pace: read, then change.",
          "type": "string"
        },
        {
          "const": "progressive",
          "description": "Compositions keep building within a scene.",
          "type": "string"
        },
        {
          "const": "active",
          "description": "Frequent changes.",
          "type": "string"
        },
        {
          "const": "high_frequency",
          "description": "Constant rapid change.",
          "type": "string"
        }
      ]
    },
    "RefScale": {
      "enum": [
        "subtle",
        "moderate",
        "large",
        "dramatic"
      ],
      "type": "string"
    },
    "RefTemperament": {
      "oneOf": [
        {
          "const": "restrained",
          "description": "Small, slow, soft moves.",
          "type": "string"
        },
        {
          "const": "fluid",
          "description": "Smooth continuous easing.",
          "type": "string"
        },
        {
          "const": "snappy",
          "description": "Quick decisive arrivals, short settles.",
          "type": "string"
        },
        {
          "const": "energetic",
          "description": "Big fast moves, visible overshoot.",
          "type": "string"
        },
        {
          "const": "cinematic",
          "description": "Slow dramatic camera-like moves.",
          "type": "string"
        },
        {
          "const": "playful",
          "description": "Bouncy, elastic.",
          "type": "string"
        },
        {
          "const": "mechanical",
          "description": "Linear, stepwise, machine-like.",
          "type": "string"
        }
      ]
    },
    "RefTemperature": {
      "oneOf": [
        {
          "enum": [
            "warm",
            "cool"
          ],
          "type": "string"
        },
        {
          "const": "neutral",
          "description": "Grey / balanced.",
          "type": "string"
        }
      ]
    },
    "RefTone": {
      "description": "Overall design character.",
      "oneOf": [
        {
          "const": "editorial",
          "description": "Magazine-like: typographic hierarchy, restraint, print sensibility.",
          "type": "string"
        },
        {
          "const": "technical",
          "description": "Precise, systematic, data/UI-like: grids, mono or condensed type.",
          "type": "string"
        },
        {
          "const": "playful",
          "description": "Bold graphic, colorful, bouncy.",
          "type": "string"
        }
      ]
    },
    "RefTransition": {
      "oneOf": [
        {
          "const": "subtle",
          "description": "Soft crossfades.",
          "type": "string"
        },
        {
          "const": "editorial",
          "description": "Crossfade/lift with occasional graphic accents.",
          "type": "string"
        },
        {
          "const": "geometric",
          "description": "Straight-edged panel wipes and lateral handoffs.",
          "type": "string"
        },
        {
          "const": "kinetic",
          "description": "Fast sweeps, punches, energetic wipes.",
          "type": "string"
        },
        {
          "const": "continuous",
          "description": "Elements continue from one composition into the next.",
          "type": "string"
        },
        {
          "const": "hard",
          "description": "Hard cuts.",
          "type": "string"
        },
        {
          "const": "cinematic",
          "description": "Slow dissolves, camera-driven handoffs.",
          "type": "string"
        }
      ]
    },
    "Trait": {
      "additionalProperties": false,
      "description": "One inferred dimension: a value from the closed vocabulary (or null = unknown), how sure\nthe interpreter is, and optionally which evidence supported it.",
      "properties": {
        "confidence": {
          "description": "0..1. Values below 0.5 are recorded but not applied.",
          "format": "float",
          "type": "number"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceLinks"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional provenance."
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefTone"
            },
            {
              "type": "null"
            }
          ],
          "description": "The observed tendency, or null when unknown."
        }
      },
      "required": [
        "confidence"
      ],
      "type": "object"
