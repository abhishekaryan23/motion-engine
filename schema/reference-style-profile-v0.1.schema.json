  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Reusable style principles observed in a reference video. Every dimension is optional:\nomit it, or give `\"value\": null`, when the reference does not show it clearly. Values are\ntendencies of the whole piece, never instructions for a particular frame.",
  "properties": {
    "approximate_palette_evidence": {
      "description": "Up to 8 approximate colors copied from the deterministic evidence (`color.palette`).\nEvidence only: the engine maps them into its own curated palette families.",
      "items": {
        "$ref": "#/$defs/PaletteEvidenceSwatch"
      },
      "type": "array"
    },
    "background_character": {
      "anyOf": [
        {
          "$ref": "#/$defs/Trait6"
        },
        {
          "type": "null"
        }
      ],
      "description": "What typically sits behind the content."
    },
    "composition_rhythm": {
      "anyOf": [
        {
          "$ref": "#/$defs/Trait11"
        },
        {
          "type": "null"
        }
      ],
      "description": "How often the composition meaningfully changes (from visual change, never audio)."
    },
    "contrast": {
      "anyOf": [
        {
          "$ref": "#/$defs/Trait4"
        },
        {
          "type": "null"
        }
      ],
      "description": "Tonal contrast between grounds and content."
    },
    "image_treatment": {
      "anyOf": [
        {
          "$ref": "#/$defs/Trait9"
        },
        {
          "type": "null"
        }
      ],
      "description": "How photographs or illustrations are treated. `none` when the reference has no images."
    },
    "layer_activity": {
      "anyOf": [
        {
          "$ref": "#/$defs/Trait15"
        },
        {
          "type": "null"
        }
      ],
      "description": "How present/active the foreground, midground and background layers are."
    },
    "material_character": {
      "anyOf": [
        {
          "$ref": "#/$defs/Trait8"
        },
        {
          "type": "null"
        }
      ],
      "description": "Surface finish of grounds and graphic elements."
    },
    "motion_temperament": {
      "anyOf": [
        {
          "$ref": "#/$defs/Trait12"
        },
        {
          "type": "null"
        }
      ],
      "description": "How elements generally move."
    },
    "palette_character": {
      "anyOf": [
        {
          "$ref": "#/$defs/Trait5"
        },
        {
